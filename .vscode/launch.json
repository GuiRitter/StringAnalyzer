				"--dart-define",
				"APP_NAME=string_analyzer"
			]
		},
		{
			"name": "string_analyzer (release mode)",
			"request": "launch",
			"type": "dart",
			"flutterMode": "release",
			"toolArgs": [
				"--dart-define",
				"APP_NAME=string_analyzer"
			]
		}
